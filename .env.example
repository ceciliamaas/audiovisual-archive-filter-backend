# Copy this file to .env and fill in your actual values

# ================================
# API Configuration
# ================================

# Replicate API Token (for CLIP embeddings and YOLO object detection)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# ================================
# Storage Configuration  
# ================================

# Storj S3 Configuration
# Get these from your Storj DCS account
STORJ_ENDPOINT_URL=https://gateway.storjshare.io
STORJ_ACCESS_KEY=your_storj_access_key_here
STORJ_SECRET_KEY=your_storj_secret_key_here
STORJ_BUCKET_NAME=your_bucket_name_here

# Storage Mode Options:
# - "auto": Prefer S3 if available, fallback to local (default)
# - "s3-only": Use only S3 storage, no local fallback
# - "local-only": Use only local storage, ignore S3
# - "hybrid": Use both S3 and local with fallback enabled
STORAGE_MODE=auto

# Set to "true" to enable local fallback even in auto mode
# Set to "false" to disable local fallback (S3-only when S3 is available)
USE_LOCAL_FALLBACK=false

# ================================
# Development Settings
# ================================

# Set to "true" to enable debug mode
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Set to "true" to enable performance profiling
ENABLE_PROFILING=false

# ================================
# Deployment Notes
# ================================

# For production deployment with S3-only mode:
# 1. Set STORAGE_MODE=s3-only
# 2. Set USE_LOCAL_FALLBACK=false  
# 3. Ensure S3 credentials are configured
# 4. The local data/ directory will be ignored
# 5. All data will be served from S3

# For local development with existing data:
# 1. Set STORAGE_MODE=local-only
# 2. Keep your local data/ directory

# For hybrid mode (S3 primary with local fallback):
# 1. Set STORAGE_MODE=hybrid or auto
# 2. Set USE_LOCAL_FALLBACK=true